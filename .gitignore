# Ignore local Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Ignore local execution directories
.terraform/
.terraform.lock.hcl

# Ignore local plan output files
*.tfplan
tfplan

# Ignore secret variable files
*.secret.tfvars
secrets.tfvars
terraform.tfvars

# Allow environment definition files
!environments/**/*.tfvars


# Built Synthetics canary zips (infrastructure/app-cluster/01-infra/observability.tf)
.build/
